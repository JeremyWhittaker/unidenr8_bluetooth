# Uniden R8 background collector.
#
# INSTALL IT WITH THE SCRIPT, NOT BY HAND:
#
#     ./scripts/install-service.sh              # install, enable at boot, start
#     ./scripts/install-service.sh --dry-run    # print the rendered unit only
#     ./scripts/uninstall-service.sh            # stop and remove it
#
# The script derives User=, WorkingDirectory=, ExecStart=, PYTHONPATH,
# UNIDEN_R8_CONFIG and ReadWritePaths= from the tree it is run out of and from
# the node's own configuration file, then verifies the result against the
# telemetry counter rather than against systemd's opinion of the process.
#
# The paths below are this project's own node and are placeholders. Installing
# this file unmodified on any other host produces a service that starts, reports
# `active (running)`, and does nothing -- which is the failure mode the script
# exists to remove.
#
# It deliberately does NOT Require or Want the RFCOMM unit. Ordering after it is
# useful; pulling it in is not this unit's business, and a unit that can start
# the vehicle's RFCOMM binding is a unit that can interfere with it. The
# collector checks the OBDLink's health itself, read-only, and pauses when it is
# unhealthy -- that check is the real protection, not a dependency edge.

[Unit]
Description=Uniden R8 BLE collector (receive-only, publishes state and events)
Documentation=file:/home/jeremy/unidenr8/docs/RUNBOOK.md
After=bluetooth.service hummer-rfcomm.service
Wants=bluetooth.service

# At most five starts an hour before systemd gives up. A collector that cannot
# stay up must not spend the night reconnecting to a radio the vehicle shares.
# These are [Unit] keys: systemd ignores them under [Service], which would
# leave the loop unbounded while looking correct.
StartLimitIntervalSec=3600
StartLimitBurst=5

[Service]
Type=simple
User=jeremy
Group=jeremy
WorkingDirectory=/home/jeremy/unidenr8
Environment=PYTHONPATH=/home/jeremy/unidenr8/src
Environment=PYTHONUNBUFFERED=1
# Naming the configuration file explicitly rather than letting the search find
# one: a service whose behaviour depends on its working directory is a service
# that behaves differently when someone runs it by hand to debug it.
Environment=UNIDEN_R8_CONFIG=/home/jeremy/unidenr8/unidenr8.toml
UMask=0077
ExecStart=/home/jeremy/unidenr8/.venv/bin/python -m uniden_r8.cli collect

# `always`, not `on-failure`. In continuous mode the collector has no clean
# self-exit: it loops over connect/stream/backoff until it is signalled, so an
# exit of any kind means something went wrong and the vehicle is unattended.
# `systemctl stop` and `restart` are unaffected -- systemd does not re-trigger a
# unit it stopped itself. StartLimitBurst above is what stops a hot loop.
Restart=always
RestartSec=30

# SIGTERM must have time to unsubscribe, release the link, end any open alert
# track, flush the history writer and publish a stopped state. The collector
# handles all of that; this gives it room.
KillSignal=SIGTERM
TimeoutStopSec=30

# The collector never needs to grow privilege, never needs another user's
# files, and writes in exactly one place.
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# The state directory holds state.json, state-v2.json, collector.lock and,
# when history is enabled, the SQLite database and its -wal/-shm companions.
# All of them live here, so this is the only writable path the unit needs.
ReadWritePaths=/home/jeremy/unidenr8/.state
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
# The collector talks to BlueZ over the system D-Bus, to gpsd and to an MQTT
# broker over TCP, and binds a loopback port for the optional feed.
#
# AF_BLUETOOTH is here for the OBD guard, not for the detector. The BLE link is
# D-Bus (AF_UNIX), but the guard shells out to `rfcomm` to read which device
# nodes are bound, and that tool opens
# `socket(AF_BLUETOOTH, SOCK_RAW, BTPROTO_RFCOMM)` -- measured with strace on
# the node, not assumed. Without AF_BLUETOOTH that socket call fails, `rfcomm`
# lists nothing, the guard reads "not bound", and the collector sits in
# `obd-blocked` forever while systemd reports `active (running)`. It captures
# nothing and looks healthy doing it. Do not remove this line to tighten the
# sandbox; removing it does not tighten anything, it just breaks the guard.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_BLUETOOTH

[Install]
# `./scripts/install-service.sh` enables this by default, because a collector
# that has to be started by hand is a collector that is not running during the
# drive you wanted to capture. Pass --no-enable to install without it.
WantedBy=multi-user.target
